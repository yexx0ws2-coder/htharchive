{
  "name": "htharchive",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS"
  },
"previews": {
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hth-archive-db",
      "database_id": "여기에 D1 database ID"
    }
  ]
}
